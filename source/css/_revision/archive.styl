// ─────────────────────────────────────────────────────────────
// 归档 / 统计页（/categories/）
// 全部规则 scope 在 .categories-dashboard 之下 —— 该类仅 pages/archive.pug 使用，
// 因此不影响「关于我」页与各分类页。下方 .category-lists 与标签云规则为共用规则，保持原样。
// 视觉语言：卡片沿用站点既有 .card-style，并镜像 #profile .card-style 的液态玻璃配方，
//           使本页与「关于我」页属于同一套 dashboard。圆角 12px（与 #profile 一致）。
// 注意：主题 html 根字号为 20px（非 16px），故 1rem = 20px。
// ─────────────────────────────────────────────────────────────

.categories-dashboard {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: auto;

    // 液态玻璃：与「关于我」页 #profile .card-style 完全一致的取值。
    // 此处镜像一份而非复用选择器，是为了不改动 profile 侧已定稿的规则。
    .card-style {
        position: relative;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(255, 255, 255, .11), rgba(255, 255, 255, .04) 46%, rgba(255, 255, 255, .08));
        -webkit-backdrop-filter: blur(26px) saturate(150%);
        backdrop-filter: blur(26px) saturate(150%);
        border: 1px solid rgba(255, 255, 255, .18);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .28), inset 0 -1px 0 rgba(255, 255, 255, .06), 0 6px 20px rgba(0, 0, 0, .14), 0 2px 6px rgba(0, 0, 0, .06);
        transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s ease, background .45s ease;
        text-shadow: 0 1px 2px rgba(0, 0, 0, .22);

        // 顶部镜面反光带
        &::before {
            content: '';
            position: absolute;
            top: 0;
            left: 10%;
            right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .30), transparent);
            pointer-events: none;
            z-index: 2;
        }

        &:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, rgba(255, 255, 255, .12), rgba(255, 255, 255, .05) 46%, rgba(255, 255, 255, .09));
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .30), inset 0 -1px 0 rgba(255, 255, 255, .06), 0 10px 30px rgba(0, 0, 0, .18), 0 3px 10px rgba(0, 0, 0, .08);
        }
    }

    // ① 概览：四张**独立**小卡片排成 2×2；行高与右侧旭日图对齐（1fr 1fr 撑满，不留空）
    .arc-overview {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: 1fr 1fr;
        gap: .8rem;
        min-width: 0;

        +maxWidth768() {
            gap: .6rem;
        }

        .arc-stat {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .8rem 1rem;
            min-width: 0;

            .arc-stat__icon {
                font-size: 1.3rem;
                color: $theme-color;
                flex-shrink: 0;
                text-shadow: none;   // 图标不需要文字投影
            }

            .arc-stat__main {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            // 次要文字统一用 --toc-link-color（亮色 #666261 / 暗色 rgba(255,255,255,.6)），
            // 不用 opacity 淡化 —— 那会把对比度压到约 2:1，实际看不清。
            .arc-stat__label {
                font-size: .64rem;
                color: var(--toc-link-color);
                letter-spacing: .06em;
            }

            .arc-stat__body {
                display: flex;
                align-items: baseline;
                gap: .25rem;
            }

            .arc-stat__value {
                font-family: 'Audiowide', cursive;
                font-size: 1.55rem;
                line-height: 1.15;
                color: var(--font-color);
            }

            .arc-stat__unit {
                font-size: .62rem;
                color: var(--toc-link-color);
            }

            // 补充信息：两行小字，比主数值弱一档但仍用 --toc-link-color 保证可读
            .arc-stat__meta {
                display: flex;
                flex-direction: column;
                gap: .12rem;
                margin-top: .3rem;
                min-width: 0;

                span {
                    font-size: .58rem;
                    line-height: 1.25;
                    color: var(--toc-link-color);
                    letter-spacing: .02em;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
            }
        }
    }

    // ②③ 每行两列，等高（align-items: stretch）避免参差
    .arc-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: stretch;

        +maxWidth768() {
            grid-template-columns: 1fr;
        }

        // 独占整行（97 个月的发布节奏横向空间更值钱）
        &.arc-row--single {
            grid-template-columns: 1fr;
        }
    }

    // 图表卡
    .arc-chart {
        display: flex;
        flex-direction: column;
        padding: 1rem 1rem .6rem;
        min-width: 0;
        overflow: hidden;

        .arc-chart__title {
            font-size: .7rem;
            color: var(--toc-link-color);
            letter-spacing: .06em;
            margin-bottom: .2rem;
            flex-shrink: 0;
        }

        #categories-chart, #year-chart, #posts-chart {
            width: 100%;
            height: 17rem;

            +maxWidth768() {
                height: 15rem;
            }
        }

        // 分类图在首行右列（半宽），高度与左侧 2×2 统计卡所在行协调
        #categories-chart {
            height: 22rem;

            +maxWidth768() {
                height: 22rem;
            }
        }

        // 标签条形图有 15 行，需要更高一点
        #tags-chart {
            width: 100%;
            height: 20rem;

            +maxWidth768() {
                height: 17rem;
            }
        }
    }

    // 整行的发布节奏给更高的图
    .arc-row--single .arc-chart #posts-chart {
        height: 18rem;
    }
}

.category-lists {
    .category-list {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-content: stretch;

        .category-list-item {
            // border:  solid 2px #a4b0be
            border-radius: 5px;
            margin: 0 0.5rem;
            background-color: rgba(150, 150, 150, 0.05);
            width: 30%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;

            .category-list-item {
                width: 100%;
                background-color: rgba(150, 150, 150, 0);
            }
        }

        .category-list-item::before {
            display: none;
        }

        .category-list-child {
            .category-list-item::before {
                display: block;
            }
        }
    }

    +maxWidth768() {
        white-space: nowrap;
        font-size: 0.5rem;
    }
}

.tag-cloud-list {
    padding: 10px 0;

    a {
        border-radius: 5px;
        margin: 0 2px;
        display: inline-block;
        padding: 0 0.4rem;
        transition: all 0.3s;
        background-color: rgba(150, 150, 150, 0.05);

        &:hover {
            color: $text-hover !important;
            transform: scale(1.1);
        }
    }
}

.tag-cloud--title {
    font-size: 2.57em;

    +maxWidth768() {
        font-size: 2em;
    }
}
