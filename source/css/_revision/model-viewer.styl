// R-060：首页自托管 model-viewer（替代 Sketchfab iframe）。
// 说明：主题样式入口 themes/hexo-theme-unicorn/source/css/index.styl 已有 @import '_revision/*'，
// 本文件放在 _revision/ 下即自动生效，无需改入口。

.model-viewer-wrapper
  position: relative
  width: 100%
  height: 100%
  overflow: hidden

.model-viewer-wrapper model-viewer,
model-viewer
  width: 100%
  height: 100%
  display: block
  background-color: transparent
  opacity: 0
  transition: opacity .35s ease

//- R-075：模型真正 load 之后（JS 加 .mv-ready）才淡入，避免未升级元素长期占位
.model-viewer-wrapper.mv-ready model-viewer
  opacity: 1

//- R-075：封面用 background-image（绕开 post_lazyload 过滤器；否则 <img> 被改写成 1x1 占位 → 加载期空白）
.mv-cover
  background-size: cover
  background-position: center center
  background-repeat: no-repeat
  background-color: transparent

//- R-075：不设 z-index —— 靠 DOM 顺序保证封面在 model-viewer 之上、但在 #site-name / #pined-pages 等文案之下
#model_viewer_loading_cover
  position: absolute
  inset: 0
  display: flex
  align-items: center
  justify-content: center
  pointer-events: none

//- R-288（2026-10-17 用户「首页的 3D 按钮都集中在下方的按钮，可以切换不同的模型」）：
//-   底部「3D 控制坞」——把加载入口（图标按钮）与模型切换 pill 收成一行、居中悬浮。
//-   z-index: 3 必须压过 #carousel .site-info：后者 fixed 定位且 DOM 在 wrapper 之后（z-index auto），
//-   修复前它把入口整个吞掉，Lead 用 CDP elementFromPoint(中心) 实测到 DIV#.site-info。
.mv-dock
  position: absolute
  left: 50%
  bottom: 24px
  z-index: 3
  transform: translateX(-50%)
  display: flex
  align-items: center
  gap: 8px
  max-width: calc(100% - 24px)
  padding: 6px 8px
  border: 1px solid rgba(255, 255, 255, .16)
  border-radius: 999px
  background-color: rgba(16, 17, 22, .55)
  -webkit-backdrop-filter: blur(8px)
  backdrop-filter: blur(8px)
  box-shadow: 0 4px 18px rgba(0, 0, 0, .28)
  +maxWidth600()
    //- 移动端：抬到 .site-info 文案块（实测高约 257px，占底部 ~30%）之上，且避开右侧 #carousel-indictors
    bottom: 42%
    gap: 6px
    padding: 5px 6px

//- 模型 pill：本地 GLB / 备用 Sketchfab 视图共用；按下态（aria-pressed="true"）= 当前展示的模型。
.mv-model-btn
  display: flex
  align-items: center
  justify-content: center
  height: 32px
  padding: 0 12px
  border: 0
  border-radius: 999px
  background-color: transparent
  color: rgba(255, 255, 255, .74)
  font-size: 12px
  line-height: 1
  letter-spacing: .02em
  white-space: nowrap
  cursor: pointer
  transition: background-color .2s ease, color .2s ease
  -webkit-tap-highlight-color: transparent
  &:hover
    color: #fff
    background-color: rgba(255, 255, 255, .14)
  &:focus-visible
    outline: 2px solid #fff
    outline-offset: 2px
  &[aria-pressed="true"]
    color: #15161a
    background-color: rgba(255, 255, 255, .92)

//- R-092（round-045 用户报障#1）：3D 入口图标化 —— 按钮内只有内联 SVG，没有任何可见中英文文案；
//-   状态只在 data-state 上表达（idle|slow|loading|retry|ready），无障碍文案放在 aria-label/title。
//-   R-288：位置由控制坞决定（position: static），尺寸收到 38×38，配色随坞。
//- R-290（2026-10-18 用户 m11298）：控制坞只剩这一个图标入口 —— 必须常驻可见（原来只在
//-   mv-needs-click 时 display:flex，pill 移除后就再也没有切回备用视图的入口了）。
.model-viewer-hint
  display: flex
  position: static
  transform: none
  width: 38px
  height: 38px
  min-width: 38px
  min-height: 38px
  padding: 0
  border: 0
  border-radius: 999px
  background-color: rgba(255, 255, 255, .12)
  color: #fff
  cursor: pointer
  align-items: center
  justify-content: center
  -webkit-tap-highlight-color: transparent
  &:hover
    background-color: rgba(255, 255, 255, .2)
  &:focus-visible
    outline: 2px solid #fff
    outline-offset: 2px
  svg
    display: none
    width: 22px
    height: 22px
    fill: currentColor
  &[data-state=idle] svg.mv-ico-idle,
  &[data-state=ready] svg.mv-ico-idle,
  &[data-state=slow] svg.mv-ico-idle
    display: block
  &[data-state=loading] svg.mv-ico-loading
    display: block
    animation: mv-ico-spin 1s linear infinite
  &[data-state=retry] svg.mv-ico-retry
    display: block

@keyframes mv-ico-spin
  to
    transform: rotate(360deg)

@media (prefers-reduced-motion: reduce)
  .model-viewer-hint[data-state=loading] svg.mv-ico-loading
    animation: none

//- 弱网/省流/超时/失败：封面 + 图标入口变成可点击，点后才下载 1 MiB viewer 脚本
#model_viewer_wrapper.mv-needs-click #model_viewer_loading_cover
  pointer-events: auto
  cursor: pointer

#model_viewer_wrapper.mv-needs-click #model_viewer_hint
  display: flex

.model-viewer-fallback
  position: absolute
  inset: 0
  display: none
  align-items: center
  justify-content: center

.mv-cover-fallback
  position: absolute
  inset: 0

.model-viewer-fallback .model-viewer-hint
  display: flex

//- R-276（2026-10-16 用户指示）：备用 Sketchfab 视图 —— iframe 默认完全隐藏（hidden + display:none 双保险），
//-   由右下角隐蔽小按钮切换。按钮刻意做小、低透明度；class 不带 model-viewer-hint，
//-   因此不参与 check-site 的 R-225 主入口契约（那条契约只作用于 .model-viewer-hint）。
.model-viewer-sf-backup
  position: absolute
  inset: 0
  display: none
  z-index: 2
  background-color: #000
  iframe#sketchfab-model
    position: absolute
    top: 0
    left: 0
    display: block
    width: 100%
    height: 100%
    border: 0
    background: rgba(0, 0, 0, .5)
  #sketchfab_loading_cover
    position: absolute
    inset: 0
    pointer-events: none
    img
      width: 100%
      height: 100%
      object-fit: cover

//- 注意：这里刻意把 selector list 拆成单条嵌套规则 —— 嵌套块里的 `model-viewer,` 会被 stylus
//-   当成属性声明，编译出 `mv-sf-on{model-viewer:,}` 这种垃圾（且 model-viewer 不会被隐藏）。
#model_viewer_wrapper.mv-sf-on
  .model-viewer-sf-backup
    display: block
  model-viewer
    display: none
  #model_viewer_loading_cover
    display: none
  //- R-290：切到备用 iframe 视图后入口必须继续可见（否则无法切回本地模型）；
  //-   文案由脚本改成「切换回本地 3D 模型」。
  .model-viewer-hint
    display: flex
  .model-viewer-fallback
    display: none

//- R-288：备用视图按钮现在是控制坞里的模型 pill —— 尺寸/配色/按下态全部由 .mv-model-btn 提供，
//-   因此不再有 absolute 定位与 28×28 低透明度小按钮；id/class/data-sf-js/data-sf-uid 契约保持不变
//-   （check-site R-276 依赖），#model_viewer_wrapper.mv-sf-on 的隐藏规则也保持不变。
