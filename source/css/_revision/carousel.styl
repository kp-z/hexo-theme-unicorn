#show-index-info
    display: none
    position: fixed
    bottom : 2rem
    left: 2rem
    color: var(--white)
    border-radius: 5px
    cursor: pointer
    font-family: 'Audiowide', cursive
    padding: 0 3px
    &:hover
        background: rgba(white, .5)
        transition: background 0.5s;
        -webkit-transition: background 0.5s; /* Safari */
.site-name
    cursor: pointer
    position: fixed
    left: 1.5rem
    top: 40%
    line-height: 1
    a
        font-size: 4.8vw
        color: var(--white)
        font-family: 'Audiowide', cursive
    +maxWidth600()
        display: none
.pined-pages
    position: fixed
    right: 4rem
    top: 35%
    width: 16%
    height: 50%
    +maxWidth600()
        display: none
    p
        font-size: .8vw
        color: var(--white)
        opacity : .6
        font-family: 'Audiowide', cursive
    // ===== 长气泡卡片 =====
    .page
        position: absolute
        display: flex
        align-items: center
        justify-content: space-between
        gap: 7px
        width: 100%
        height: auto
        min-height: 54px
        padding: 8px 14px 8px 12px
        border-radius: 15px
        background: linear-gradient(135deg, rgba(255,255,255,.26), rgba(255,255,255,.12) 55%, rgba(255,255,255,.20))
        border: 1px solid rgba(255,255,255,.30)
        box-shadow: inset 0 1px 0 rgba(255,255,255,.5), inset 0 -1px 0 rgba(255,255,255,.10), 0 3px 12px rgba(0,0,0,.16)
        backdrop-filter: blur(20px)
        -webkit-backdrop-filter: blur(20px)
        cursor: pointer
        overflow: hidden
        animation: bubble-float 12s ease-in-out infinite
        transition: box-shadow .45s ease, background .45s ease, border-color .45s ease

        &::after
            content: ''
            position: absolute
            top: 5px
            left: 14px
            width: 24px
            height: 5px
            border-radius: 50%
            background: rgba(255, 255, 255, .45)
            filter: blur(3px)
            pointer-events: none

        &:hover
            animation-play-state: paused
            background: linear-gradient(135deg, rgba(255,255,255,.36), rgba(255,255,255,.20))
            border-color: rgba(255,255,255,.50)
            box-shadow: inset 0 1px 0 rgba(255,255,255,.65), 0 6px 18px rgba(0,0,0,.22)

        img
            order: 2
            flex: 0 0 auto
            float: none
            width: auto
            max-width: 24%
            height: auto
            max-height: 36px
            object-fit: contain
            border-radius: 6px

        .description
            order: 1
            flex: 1
            min-width: 0
            display: block
            width: auto
            height: auto
            overflow: visible

            // 模板里 a 之后有一个多余 <br>，会白白撑高约一行
            br
                display: none

            a, p
                display: -webkit-box
                -webkit-box-orient: vertical
                -webkit-line-clamp: 2
                overflow: hidden
                line-height: 1.35
                font-size: 12px
                font-weight: 400
                color: var(--white)
                text-shadow: 0 1px 2px rgba(0, 0, 0, .18)

    .top
        top: 20%
        animation-delay: 0s
    .mid
        top: 50%
        right: 0
        animation-delay: -4s
    .bot
        top: 80%
        right: 30%
        animation-delay: -8s

@keyframes bubble-float
    0%, 100%
        transform: translateY(7px) scale(.995)
    50%
        transform: translateY(-9px) scale(1.005)

#carousel
    position: fixed
    top: 0
    left: 0
    .carousel-box
        display: none
        transition: all 1s
        height: 100%
        width: 100%
        overflow: hidden
        .site-info
            position: fixed
            bottom: 1rem
            padding: 0
            width: 100%
            .site-title,
            .site-subtitle
                text-shadow: .1rem .1rem .2rem rgba(0, 0, 0, .15)
                line-height: 1.4
                width:  20%
                +maxWidth600()
                    width: 75%
                a
                    color: var(--white)
                    border-radius: 5px
                    cursor: pointer
                    padding: 0 3px
                    &:hover
                        background: rgba(white, .5)
                        transition: background 0.5s;
                        -webkit-transition: background 0.5s; /* Safari */
                .info-link
                    background: linear-gradient(to bottom , rgba(0,0,0, 0) 70%, rgba(160,216,120, 0.5) 70% 90%, rgba(white, 0) 90%); 
                    transition: background 0.5s;
                    -webkit-transition: background 0.5s; /* Safari */
            .site-title
                position: relative
                margin: 2rem
                letter-spacing: 4px
                color: var(--white)
                font-size: .8vw
                font-family: 'Audiowide', cursive
                +maxWidth600()
                    font-size: 7vw
                    margin: 2rem 1rem
                a
                    position: absolute
                    left: 40%
                    +maxWidth600()
                        left: 80%
                        
            .site-subtitle
                letter-spacing: 1px
                margin: 2rem
                color: var(--white)
                font-size: 1.2vw
                opacity : .8
                font-weight: normal
                +maxWidth600()
                    font-size: 6vw
                    margin: 2rem 1rem
                    
    #carousel-indictors
        // text-align:center
        position: fixed
        bottom: 0.5rem
        right: 1rem
        margin: 2rem
        +maxWidth600()
            bottom: 4.5rem
            margin: 2rem 0rem
        .carousel-dot 
            cursor: pointer
            height: 20px
            width: 20px
            margin: 10px 0 0 0
            background-color: var(--light-grey)
            border-radius: 50%
            display: block
            opacity : .2
            backdrop-filter: blur(20px);
            transition: background-color 0.6s ease
            +maxWidth600()
                height: 15px
                width: 15px
        .active, .carousel-dot:hover 
            // background-color: var(--white)
            opacity : 1
.sketchfab-embed-wrapper
    #sketchfab-model
        position:fixed
        top:0
        left:0
        display: block;
        width: 100%
        margin-top: -5%
        margin-bottom: -5%
        background: rgba(0,0,0,0.5)
        +maxWidth600()
            margin-top: -15%

     #sketchfab_loading_cover
        img
            position: fixed;
            object-fit: cover
            width: 100%;
            height: 100%;
    .sketchfab_loaded
        transition: all .5s
        // transform: translate(-100%, 0)
        pointer-events: none
        display: none
        opacity : 0

        
