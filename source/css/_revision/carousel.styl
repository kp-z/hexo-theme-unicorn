#show-index-info
    display: none
    position: fixed
    bottom : 2rem
    left: 2rem
    color: var(--white)
    border-radius: 5px
    cursor: pointer
    font-family: 'Audiowide', cursive
    padding: 0 3px
    &:hover
        background: rgba(white, .5)
        transition: background 0.5s;
        -webkit-transition: background 0.5s; /* Safari */
.site-name
    cursor: pointer
    position: fixed
    left: 1.5rem
    top: 40%
    line-height: 1
    a
        font-size: 4.8vw
        color: var(--white)
        font-family: 'Audiowide', cursive
    +maxWidth600()
        display: none
.pined-pages
    position: fixed
    right: 4rem
    top: 35%
    width: 20%
    // 一次显示 3 个完整气泡（标题 18 + 3×38 + 3×3 间距 ≈ 141px，另留约 17px 让第 4 个在底部淡出）
    max-height: 158px
    display: flex
    flex-direction: column
    gap: 3px
    overflow-y: auto
    overflow-x: hidden
    // 上下边界模糊淡出（可滚动提示）
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16px, #000 calc(100% - 16px), transparent 100%)
    mask-image: linear-gradient(to bottom, transparent 0, #000 16px, #000 calc(100% - 16px), transparent 100%)
    // 隐藏滚动条（以模糊边界提示可滚动）
    scrollbar-width: none
    -ms-overflow-style: none
    +maxWidth600()
        display: none

    &::-webkit-scrollbar
        width: 0
        display: none

    p
        flex: 0 0 auto
        margin: 0 0 1px 2px
        font-size: .8vw
        color: var(--white)
        opacity: .6
        font-family: 'Audiowide', cursive

    // ===== 长气泡（最近 10 篇） =====
    .page
        position: relative
        flex: 0 0 auto
        display: flex
        align-items: center
        justify-content: space-between
        gap: 6px
        width: 78%
        min-height: 36px
        padding: 4px 10px 4px 9px
        // 左右穿插：奇偶两侧交错，不再整齐对齐
        &:nth-child(odd)
            align-self: flex-end
        &:nth-child(even)
            align-self: flex-start
        border-radius: 15px
        background: linear-gradient(135deg, rgba(255,255,255,.26), rgba(255,255,255,.12) 55%, rgba(255,255,255,.20))
        border: 1px solid rgba(255,255,255,.30)
        box-shadow: inset 0 1px 0 rgba(255,255,255,.5), inset 0 -1px 0 rgba(255,255,255,.10), 0 3px 12px rgba(0,0,0,.16)
        backdrop-filter: blur(20px)
        -webkit-backdrop-filter: blur(20px)
        cursor: pointer
        overflow: hidden
        // 入场：逐个向上浮现（用 translate 独立属性，避免与漂浮的 transform 互相覆盖）
        // 漂浮：入场结束后无缝接上，缓慢循环
        animation: bubble-in .7s cubic-bezier(.2, .8, .2, 1) both, bubble-float 12s ease-in-out infinite
        transition: box-shadow .45s ease, background .45s ease, border-color .45s ease

        // 逐个浮现：延迟由模板注入的 --i 驱动，数量变化时自动适配
        animation-delay: calc(var(--i, 0) * .13s), calc(1.2s + var(--i, 0) * .13s)

        &::after
            content: ''
            position: absolute
            top: 5px
            left: 14px
            width: 24px
            height: 5px
            border-radius: 50%
            background: rgba(255, 255, 255, .45)
            filter: blur(3px)
            pointer-events: none

        &:hover
            animation-play-state: paused, paused
            background: linear-gradient(135deg, rgba(255,255,255,.36), rgba(255,255,255,.20))
            border-color: rgba(255,255,255,.50)
            box-shadow: inset 0 1px 0 rgba(255,255,255,.65), 0 6px 18px rgba(0,0,0,.22)

        img
            order: 2
            flex: 0 0 auto
            float: none
            width: auto
            max-width: 24%
            height: auto
            max-height: 24px
            object-fit: contain
            border-radius: 5px

        .description
            order: 1
            flex: 1
            min-width: 0
            display: block
            width: auto
            height: auto
            overflow: visible

            br
                display: none

            a, p
                display: -webkit-box
                -webkit-box-orient: vertical
                -webkit-line-clamp: 2
                overflow: hidden
                line-height: 1.25
                font-size: 11px
                font-weight: 400
                color: var(--white)
                text-shadow: 0 1px 2px rgba(0, 0, 0, .18)

// 逐个向上浮现
@keyframes bubble-in
    0%
        opacity: 0
        translate: 0 26px
    100%
        opacity: 1
        translate: 0 0

// 持续缓慢漂浮
@keyframes bubble-float
    0%, 100%
        transform: translateY(5px) scale(.996)
    50%
        transform: translateY(-6px) scale(1.004)

#carousel
    position: fixed
    top: 0
    left: 0
    .carousel-box
        display: none
        transition: all 1s
        height: 100%
        width: 100%
        overflow: hidden
        .site-info
            position: fixed
            bottom: 1rem
            padding: 0
            width: 100%
            .site-title,
            .site-subtitle
                text-shadow: .1rem .1rem .2rem rgba(0, 0, 0, .15)
                line-height: 1.4
                width:  20%
                +maxWidth600()
                    width: 75%
                a
                    color: var(--white)
                    border-radius: 5px
                    cursor: pointer
                    padding: 0 3px
                    &:hover
                        background: rgba(white, .5)
                        transition: background 0.5s;
                        -webkit-transition: background 0.5s; /* Safari */
                .info-link
                    background: linear-gradient(to bottom , rgba(0,0,0, 0) 70%, rgba(160,216,120, 0.5) 70% 90%, rgba(white, 0) 90%); 
                    transition: background 0.5s;
                    -webkit-transition: background 0.5s; /* Safari */
            .site-title
                position: relative
                margin: 2rem
                letter-spacing: 4px
                color: var(--white)
                font-size: .8vw
                font-family: 'Audiowide', cursive
                +maxWidth600()
                    font-size: 7vw
                    margin: 2rem 1rem
                a
                    position: absolute
                    left: 40%
                    +maxWidth600()
                        left: 80%
                        
            .site-subtitle
                letter-spacing: 1px
                margin: 2rem
                color: var(--white)
                font-size: 1.2vw
                opacity : .8
                font-weight: normal
                +maxWidth600()
                    font-size: 6vw
                    margin: 2rem 1rem
                    
    #carousel-indictors
        // text-align:center
        position: fixed
        bottom: 0.5rem
        right: 1rem
        margin: 2rem
        +maxWidth600()
            bottom: 4.5rem
            margin: 2rem 0rem
        .carousel-dot 
            cursor: pointer
            height: 20px
            width: 20px
            margin: 10px 0 0 0
            background-color: var(--light-grey)
            border-radius: 50%
            display: block
            opacity : .2
            backdrop-filter: blur(20px);
            transition: background-color 0.6s ease
            +maxWidth600()
                height: 15px
                width: 15px
        .active, .carousel-dot:hover 
            // background-color: var(--white)
            opacity : 1
.sketchfab-embed-wrapper
    #sketchfab-model
        position:fixed
        top:0
        left:0
        display: block;
        width: 100%
        margin-top: -5%
        margin-bottom: -5%
        background: rgba(0,0,0,0.5)
        +maxWidth600()
            margin-top: -15%

     #sketchfab_loading_cover
        img
            position: fixed;
            object-fit: cover
            width: 100%;
            height: 100%;
    .sketchfab_loaded
        transition: all .5s
        // transform: translate(-100%, 0)
        pointer-events: none
        display: none
        opacity : 0

        
