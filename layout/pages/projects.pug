#projects-dashbord
  // fetch articles
  // R-198（round-042）+ R-216（round-043）：稳定排序。hexo 的 warehouse .sort() 对并列项不保证
  // 顺序（输入顺序来自 DB 装载顺序，同日期文章会摇奖）。口径统一在 scripts/lib/stable_posts_core.js
  // （date 降序 → abbrlink/slug/path → path → title 字典序），模板 helper = stable_posts()。
  // 注意返回的是普通数组 ⇒ 只能 .forEach/.slice，不能 .each()（round-042 曾因此产出 0 字节页面）。
  .head
      - stable_posts(site.posts, -1).forEach(function (article) {
        
        if article.projectSticky == 1
          .div1.project-card
            include project-item.pug
        if article.projectSticky == 2
          .div2.project-card
            include project-item.pug
        if article.projectSticky == 3
          .div3.project-card
            include project-item.pug
        if article.projectSticky == 4
          .div4.project-card
            include project-item.pug
      - })

  .more-project-head
    .more-projects-head-title
      p.title   
        i.fas.fa-code-branch
          | &nbsp;
        |  More Projects
      p.info 
          | reserch index ....
    .more-project-head-list
      .project-tag(style='background:#f39c12')
        a(href=rp('/categories/项目/其他项目/')) &#x25C9; &#x5176;&#x4ED6;&#x9879;&#x76EE;
      .project-tag(style='background:#2ed573')
        a(href=rp('/categories/项目/应用开发/')) &#x25C9; &#x5E94;&#x7528;&#x5F00;&#x53D1;
      .project-tag(style='background:#1e90ff')
        a(href=rp('/categories/项目/认知机器/')) &#x25C9; &#x8BA4;&#x77E5;&#x673A;&#x5668;
  .more-project
    - stable_posts(site.posts, -1).forEach(function (article) {
      if article.project
        .more-project-weight.project-card
          include project-item.pug
    - })