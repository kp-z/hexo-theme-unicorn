#projects-dashbord
  // fetch articles
  // R-198（round-042）：稳定排序。hexo 的 warehouse .sort() 对并列项不保证顺序
  // （输入顺序来自 DB 装载顺序，同日期文章会摇奖），此处显式改为 date 降序、
  // 其次 abbrlink/slug/path 字典序、再其次 path/title 字典序。
  - function stableProjectPosts () { return site.posts.toArray().slice().sort(function (a, b) { var da = a.date ? new Date(a.date).valueOf() : 0; var db = b.date ? new Date(b.date).valueOf() : 0; if (da !== db) return db - da; var ka = String(a.abbrlink || a.slug || a.path || ''); var kb = String(b.abbrlink || b.slug || b.path || ''); if (ka !== kb) return ka < kb ? -1 : 1; var pa = String(a.path || ''); var pb = String(b.path || ''); if (pa !== pb) return pa < pb ? -1 : 1; var ta = String(a.title || ''); var tb = String(b.title || ''); if (ta === tb) return 0; return ta < tb ? -1 : 1 }) }
  .head
      - stableProjectPosts().forEach(function (article) {
        
        if article.projectSticky == 1
          .div1.project-card
            include project-item.pug
        if article.projectSticky == 2
          .div2.project-card
            include project-item.pug
        if article.projectSticky == 3
          .div3.project-card
            include project-item.pug
        if article.projectSticky == 4
          .div4.project-card
            include project-item.pug
      - })

  .more-project-head
