- let author = article.author || config.author
.project-cover
    img(src=url_for(article.top_img) alt=title onerror=`this.onerror=null;this.src='${url_for(theme.error_img.post_page)}'`)
.project-info
    .tags
        //- R-222（round-044）：tags 迭代顺序由 hexo 的 Tag 集合扫描顺序决定，不保证是 front-matter 数组顺序：
        //-   hexo 8.1.2 models/post.js 的 Post.tags getter = Tag.find({_id: {$in: ids}}) ⇒ 顺序随 Tag 集合（db）。
        //-   实测（tester 5 棵同主题基线树）projects/index.html 的「◉ <tag>」序列出现 2 种
        //-   （b4d1780fe7ed7a39 / a4e959fc2fa76807）⇒ 既有抖动。故统一走 stable_terms：
        //-   name 升序 + path 字典序 tiebreak（纯函数见 scripts/lib/stable_posts_core.js），与输入顺序无关。
        - stable_terms(article.tags).forEach(function (tag) {
            a.tag(href=url_for(tag.path) style='background:#e90ff' title=tag.name)
                | ◉ !{tag.name} &nbsp;
        - })
    br
    a.title(href=url_for(article.path) title=article.title)
        | !{article.title}
    br
    a.more
        | by !{author}  &bull;  &nbsp; !{date(article.date, config.date_format)}