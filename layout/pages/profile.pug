    #fitness-line
  #goals.dashboard-weight.card-style
    //- .goal 
    //-   a Life style part 
    //- .goal 
    //-   a is still
    //- .goal 
    //-   a building
    //- .goal
    //-   a ... ... 
    #habitica-block-1.habitica-block
    #habitica-block-2.habitica-block
    #habitica-block-3.habitica-block
    #habitica-block-4.habitica-block
