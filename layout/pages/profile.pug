#profile.gallery-group-main
  .dashboard-weight.card-style.frosted-gross
    .info-top
      .avatar
        img(data-lazy-src=url_for(theme.profile.avatar) alt='avatar')
      .author-info
        .author-info-en
          | !{theme.profile.author_info.line1}
        .author-info-cn
          | !{theme.profile.author_info.line2}
        .author-info-status
          | !{theme.profile.author_info.line3}
    .info-bot
      div
        for i in theme.profile.buttons
          a.author-btn(href=url_for(i.link))
            img(data-lazy-src=url_for(i.img) alt='button')
            .hidden-info
              | !{i.name}
        .info-tips
    .info-social
      a.info-social-i(href=url_for(theme.profile.social.github))
        i.fab.fa-github
      a.info-social-i(href=url_for(theme.profile.social.px))
        i.fab.fa-500px
      a.info-social-i(href=url_for(theme.profile.social.instagram))
        i.fab.fa-instagram
      a.info-social-i(href=url_for(theme.profile.social.telegram))
        i.fab.fa-telegram-plane
      a.info-social-i(href=url_for(theme.profile.social.youtube))
        i.fab.fa-youtube
      a.info-social-i(href=url_for(theme.profile.social.bilibili))
        i.fab.fa-bilibili
      .plant-3d
        img(src=url_for(theme.profile.decoration.plant_1) alt='plant_3d')
  .dashboard-weight
    .weight-half.card-style.top.frosted-gross
      #github_container
    .weight-half.card-style.frosted-gross
      #gantt(style='width:100%;height:100%')
  .dashboard-weight.card-style.frosted-gross
    .skills-title PROJECTS
    .plant2
      img(src=url_for(theme.profile.decoration.plant_2) alt='plant_3d')
    #sun(style='position:relative;width:100%;height:100%')
  .dashboard-weight.card-style.frosted-gross
    div
      div
        .pattern-3d
          img.rocket(src=url_for(theme.profile.decoration.rocket))
          img.cloud(src=url_for(theme.profile.decoration.cloud))
        .declaration
          | !{theme.profile.declaration}
  .dashboard-weight.card-style.video.frosted-gross
    video.card-video-black(src=url_for(theme.profile.video_black) width='100%' height='100%' controls='controls' preload='auto')
    video.card-video-white(src=url_for(theme.profile.video_white) width='100%' height='100%' controls='controls' preload='auto')
  .dashboard-weight
    .weight-quarter.card-style.frosted-gross.top.left.radar-contianer
      #radar(style='position:relative;width:100%;height:100%')
      a.personility-title(href=url_for(theme.profile.personility))
        | !{theme.profile.personility_title}
    .weight-quarter.card-style.frosted-gross.top.interests
      .interests-box
          for i in theme.profile.interests
            .interest
              img(src=url_for(i) alt='interests')
    .weight-quarter.left.card-style.frosted-gross
      img.desktop(src=url_for(theme.profile.desktop_img))
    .weight-quarter.card-style.frosted-gross
      //- R-281（2026-10-17）：访客地图 provider 改为 MapMyVisitors globe widget（用户选定）。
      //- 沿革：R-234/R-147 RevolverMaps（2024-11 停运）→ R-268 FlagCounter Flag Map（已被替换）。
      //- 本模板只输出容器 + data 契约；注入 / 同 id 去重 / 看门狗 / 降级全在 source/js/visitorMap.js。
      //- enable 为 false、provider 不是 mapmyvisitors、或 mmv_d 为空 ⇒ 容器留空（前端不注入、不降级）。
      - var __vm = theme.profile.visitor_map || {}
      if __vm.enable && __vm.provider === 'mapmyvisitors' && __vm.mmv_d
        #visitorMap.vistor-map(data-mmv-d=__vm.mmv_d data-mmv-script=__vm.mmv_script data-mmv-timeout=__vm.mmv_timeout)
      else
        #visitorMap.vistor-map
#record.gallery-group-main
  .dashboard-title
    a LIFE ADVENTURE  
  #fitness.dashboard-weight.card-style
    .fitness-title
      #fitness-circle
      .fitness-title-text
        .fitness-title-e
          a.blue Fitness
          p#fitness-times 100 Times
        .fitness-title-e
          a.green Meditation
          p#meditation-times 20 Times       
        .fitness-title-e
          a.red Others 
          p#others-times 10 Times
      //- .fitness-year 2022       
    #fitness-line
  #goals.dashboard-weight.card-style
    //- .goal 
    //-   a Life style part 
    //- .goal 
    //-   a is still
    //- .goal 
    //-   a building
    //- .goal
    //-   a ... ... 
    #habitica-block-1.habitica-block
    #habitica-block-2.habitica-block
    #habitica-block-3.habitica-block
    #habitica-block-4.habitica-block
  #reminder.dashboard-weight.card-style
    .reminder
      #today.cell
        .logo
          i.fas.fa-calendar-day
        .num 10
        .title Today
      #plan.cell
        .logo
          i.fas.fa-calendar-alt
        .num 5
        .title Plan
      #all.cell
        .logo
          i.fas.fa-inbox
        .num 50
        .title All
      #flag.cell
        .logo
          i.fas.fa-star
        .num 9
        .title Flag
    a.link(href=url_for(theme.profile.habitica))
      | !{theme.profile.habitica_info}

//- R-128b（round-030）：echarts 只在本页（profile / services 共用本模板）按需加载，
//- 且必须先于下方 profile.scripts 里的 sun/gantt/radar/fitness（它们会调用 echarts.init）。
//- R-162 S6（round-038）：改由 inject.assets 表中 slot: charts 的条目派发（pages: profile/services）。
!=inject_assets('charts')
//- R-277（2026-10-16）：pjax 站内跳转只替换 #body-wrap，页面级 <script> 不会重新执行 ⇒
//- 访客地图（visitorMap.js）留空白。带 data-pjax 的脚本由 pjax.pug 在 pjax:complete 后重建执行。
for i in theme.profile.scripts
  script(src=url_for(i) data-pjax='')
