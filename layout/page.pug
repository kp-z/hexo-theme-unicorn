extends includes/layout.pug

block content
  - var views = theme.page_views || {}
  - var viewPath = page.view && views[page.view]
  if page.type ==='flat'
    #page.recent-posts
      if viewPath
        !=partial(viewPath)
      else
        != page.content
  else 
    #page
      if viewPath
        !=partial(viewPath)
      else
        !=partial(views.default_page || 'includes/page/default-page.pug')

      if page.comments !== false && theme.comments && theme.comments.use
        !=partial('includes/third-party/comments/index', {}, {cache: true})