- var mv_js = mv.viewer_js || '/js/vendor/model-viewer/model-viewer.min.js'
- var mv_js_fb = (mv.viewer_js_fallbacks || []).join('|')
- var mv_poster = mv.poster || ((theme.pages && theme.pages.sketchfab_cover_img) || '')
- var mv_timeout = mv.timeout_ms || 8000
//- mode: click（默认）= 首屏只出封面，点击后才下载 3D；auto = 直连下自动加载
- var mv_mode = mv.mode || 'click'
- var mv_cover_style = mv_poster ? ("background-image:url('" + url_for(mv_poster) + "')") : null
//- R-276（2026-10-16 用户指示）：保留原 else 分支的 Sketchfab iframe 作为「加载失败备用视图」——
//-   默认完全隐藏（无 src ⇒ 首屏零境外请求），由右下角隐蔽小按钮手动切换；
//-   model-viewer 真正加载失败（fail()）时自动回退到它；iframe 本体不删除。
- var mv_sf_fallback = (mv.sketchfab_fallback === undefined) ? true : mv.sketchfab_fallback
- var mv_sf_js = mv.sketchfab_js || ((theme.pages && theme.pages.sketchfab) || '')
- var mv_sf_uid = mv.sketchfab_uid || '25e0e77ab56140be9fa6cb65cb4de96f'
