    //- R-290（2026-10-18 用户 m11298：「3d 按钮还是一个按钮，不需要文字，点击第一次是 iframe 第二次是模型就行」）：
    //-   控制坞只保留一个图标入口 #model_viewer_hint：第 1 次点击切到备用 Sketchfab（iframe）视图，
    //-   第 2 次点击切回本地 GLB，此后交替。文字 pill（模型名 /「原创模型」）已从可见 UI 移除。
    //-   #model_viewer_sf_toggle 保留为**隐藏的程序化切换钩子**（R-276 静态契约要求它存在并携带
    //-   data-sf-js / data-sf-uid；脚本与 check-site 都靠它注入/校验 Sketchfab SDK）。
    //-   入口必须是最上层命中目标：.mv-dock 有 z-index:3，且 #carousel .site-info 改 pointer-events:none
    //-   （_revision/carousel.styl），否则 fixed 定位的 .site-info 会吞掉点击（Lead CDP 实测）。
    .mv-dock#model_viewer_dock
      button.model-viewer-hint#model_viewer_hint(
        type="button"
        data-state="idle"
        aria-label="加载 3D 场景"
        title="加载 3D 场景"
      )
        svg.mv-ico.mv-ico-idle(viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false")
          path(d="M12 2 3 7v10l9 5 9-5V7l-9-5zm0 2.3 6.5 3.6L12 11.5 5.5 7.9l6.5-3.6zM5 9.6l6 3.3v6.5l-6-3.3V9.6zm8 9.8v-6.5l6-3.3v6.5l-6 3.3z")
        svg.mv-ico.mv-ico-loading(viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false")
          circle(cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="15 42" stroke-linecap="round")
        svg.mv-ico.mv-ico-retry(viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false")
          path(d="M12 5V2L8 6l4 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z")
      if mv_sf_on
        button.model-viewer-sf-toggle#model_viewer_sf_toggle(
          type="button"
          hidden
          tabindex="-1"
          aria-hidden="true"
          data-sf-js=url_for(mv_sf_js)
          data-sf-uid=mv_sf_uid
          data-sf-label=mv_sf_label
          aria-pressed="false"
        )
    .model-viewer-fallback#model_viewer_fallback
      if mv_poster
        .mv-cover.mv-cover-fallback(style=mv_cover_style role="img" aria-label="首页 3D 模型封面")
      button.model-viewer-hint#model_viewer_hint_retry(
        type="button"
        data-state="retry"
        aria-label="3D 场景暂不可用，点按重试"
        title="3D 场景暂不可用，点按重试"
      )
        svg.mv-ico.mv-ico-retry(viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false")
          path(d="M12 5V2L8 6l4 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z")
    //- R-276：备用 Sketchfab 视图（hidden + display:none 双保险）。
    //-   刻意不带 model-viewer-hint class ⇒ 不参与 R-225 的主入口契约检查；
    //-   iframe 不带 src ⇒ 切换前不产生任何 sketchfab.com 请求。
    if mv_sf_on
      .model-viewer-sf-backup#model_viewer_sf_backup(hidden)
        iframe#sketchfab-model(frameborder="0" sandbox="allow-scripts allow-same-origin" allow="autoplay; fullscreen; xr-spatial-tracking")
        #sketchfab_loading_cover
          .mv-cover(style=mv_cover_style role="img" aria-label="备用 3D 视图封面")

  script.
    (function () {
      var wrap = document.getElementById('model_viewer_wrapper');
      var el = document.getElementById('home-model');
      if (!wrap || !el) return;
      var cover = document.getElementById('model_viewer_loading_cover');
      var hint = document.getElementById('model_viewer_hint');
      var hintRetry = document.getElementById('model_viewer_hint_retry');
      var fb = document.getElementById('model_viewer_fallback');
      var jsList = [wrap.getAttribute('data-viewer-js')]
        .concat((wrap.getAttribute('data-viewer-js-fallbacks') || '').split('|'))
        .filter(function (u) { return !!u; });
      var timeout = parseInt(wrap.getAttribute('data-timeout'), 10) || 8000;
      var conn = navigator.connection || {};
      var slow = conn.saveData === true || /(^|-)2g$|(^|-)3g$/.test(String(conn.effectiveType || ''));
      var reduce = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      var mode = wrap.getAttribute('data-mode') || 'click';
      var optin = false;
      try { optin = localStorage.getItem('mv-optin') === '1'; } catch (err) { optin = false; }
      var started = false, settled = false, failed = false, timer = null, poll = null;
      var injected = {};
      // R-092：入口没有可见文案，状态只写 data-state；无障碍文案同步到 aria-label/title。
      var HINT_LABEL = {
        idle: '加载 3D 场景',
        slow: '加载 3D 场景',
        loading: '正在加载 3D 场景',
        retry: '3D 场景加载失败，点按重试',
        ready: '3D 场景已加载'
      };
      function setHintState(state) {
        if (!hint) return;
        hint.setAttribute('data-state', state);
        // R-290：正在显示备用 Sketchfab 视图时，入口语义是「切回本地 3D 模型」——
        //   无障碍文案由下方 sf script 的 markDock() 维护，这里不要覆盖它。
        if (wrap.classList.contains('mv-sf-on')) return;
        var label = HINT_LABEL[state] || HINT_LABEL.idle;
        hint.setAttribute('aria-label', label);
        hint.setAttribute('title', label);
        // R-290：模型就绪后入口的**动作**是切到备用视图，无障碍文案改为「查看<备用>」；
        //   具体文案由 sf script 的 markDock() 生成（sf script 在页面末尾先执行完）。
        if (state === 'ready' && typeof window.alMvSfHintReady === 'function') window.alMvSfHintReady();
      }

      function stopTimers() {
        if (timer) { clearTimeout(timer); timer = null; }
        if (poll) { clearInterval(poll); poll = null; }
      }
      function ready() {
        if (settled) return;
        settled = true;
        stopTimers();
        wrap.classList.remove('mv-needs-click');
        wrap.classList.add('mv-ready');
        setHintState('ready');
        if (cover) cover.style.display = 'none';
        if (fb) fb.style.display = 'none';
      }
      function needClick(state) {
        if (settled) return;
        wrap.classList.add('mv-needs-click');
        setHintState(state || 'idle');
      }
      function fail() {
        if (settled) return;
        settled = true;
        failed = true;
        stopTimers();
        wrap.classList.remove('mv-needs-click');
        wrap.classList.add('mv-failed');
        if (cover) cover.style.display = 'none';
        if (fb) fb.style.display = 'flex';
        // R-276：model-viewer 真正加载失败 ⇒ 自动回退到备用 Sketchfab 视图。
        //   备用视图实现放在**下面独立的 script body**（window.alMvSfEnable 钩子），
        //   本 body 只保留自己的 createElement('script') + type='module'（R-080 同 body 判定）。
        if (window.alMvSfEnable) window.alMvSfEnable();
      }
      function loadScript(i) {
        // R-092：重试时不重复注入已注入过的源（module 重复执行会 customElements.define 冲突）。
        while (i < jsList.length && injected[jsList[i]]) i++;
        if (i >= jsList.length) { needClick('retry'); return; }
        injected[jsList[i]] = true;
        var s = document.createElement('script');
        s.type = 'module';
        s.async = true;
        s.src = jsList[i];
        s.onerror = function () { loadScript(i + 1); };
        document.head.appendChild(s);
      }
      function arm() {
        if (started) return;
        started = true;
        setHintState('loading');
        if (el.loaded) { ready(); return; }
        el.addEventListener('load', ready);
        el.addEventListener('error', function () {
          if (!settled) needClick('retry');
        });
        loadScript(0);
        poll = setInterval(function () {
          if (settled) { stopTimers(); return; }
          if (el.loaded) ready();
        }, 500);
        timer = setTimeout(function () {
          if (settled) return;
          if (el.loaded) { ready(); return; }
          needClick('idle');
        }, timeout);
      }

      if (slow || reduce) {
        // 省流/弱网/reduced-motion：首屏只出图标入口（视觉同 idle，语义记为 slow）。
        needClick('slow');
      } else if (mode === 'click' && !optin) {
        // 默认不自动下载 1 MiB viewer：首屏只保留封面 + 图标入口，用户点击后再加载（可记住选择）
        needClick('idle');
      } else {
        arm();
      }
      function optIn() {
        if (settled || started) return;
        try { localStorage.setItem('mv-optin', '1'); } catch (err) { /* ignore */ }
        arm();
      }
      // R-290（用户 m11298）：控制坞只剩一个图标按钮，点击在「备用 Sketchfab iframe 视图」与
      //   「本地 GLB 模型」之间交替 —— 第 1 次点击 = iframe，第 2 次点击 = 模型，此后循环。
      //   切换钩子由下方独立的 sf script body 提供（window.alMvSfEnable / window.alMvSfDisable）；
      //   若站点关闭了 sketchfab_fallback（无钩子），退化为「点击即加载本地模型」的旧行为。
      function onHintClick() {
        var sfToggle = document.getElementById('model_viewer_sf_toggle');
        var sfReady = !!(sfToggle && window.alMvSfEnable && window.alMvSfDisable);
        if (sfReady) {
          if (wrap.classList.contains('mv-sf-on')) {
            window.alMvSfDisable();
            // 切回本地模型：已加载过 ⇒ optIn() 提前返回（settled），否则开始加载
            optIn();
          } else {
            window.alMvSfEnable();
          }
          return;
        }
        optIn();
      }

      if (cover) cover.addEventListener('click', optIn);
      // button 原生 Enter/Space 也会触发 click，键盘可达。
      if (hint) hint.addEventListener('click', onHintClick);
      if (hintRetry) {
        hintRetry.addEventListener('click', function () {
          if (!settled) return;
          settled = false;
          started = false;
          wrap.classList.remove('mv-failed');
          if (fb) fb.style.display = 'none';
          if (cover) cover.style.display = '';
          needClick('loading');
          arm();
        });
      }
      window.addEventListener('error', function (e) {
        if (!started || settled) return;
        if (e && e.target && e.target.id === 'home-model') fail();
      }, true);
    })();
  //- R-276（2026-10-16 用户指示）：备用 Sketchfab 视图 —— 右下角隐蔽按钮切换，加载失败自动回退。
  //-   刻意放在**独立 script body**：加载器 body 必须只含自己的 createElement('script') + type='module'
  //-   （R-080「同一 body」判定与 check-site 的 D10 变异都依赖这一点），classic SDK 注入不能混进去。
  //-   iframe 无 src、SDK 按需注入 ⇒ 首屏零境外请求；失败状态经 #model_viewer_wrapper 的 .mv-failed 传递。
  script.
    (function () {
      var wrap = document.getElementById('model_viewer_wrapper');
      var sfToggle = document.getElementById('model_viewer_sf_toggle');
      var sfBackup = document.getElementById('model_viewer_sf_backup');
      var cover = document.getElementById('model_viewer_loading_cover');
      var fb = document.getElementById('model_viewer_fallback');
      var hint = document.getElementById('model_viewer_hint');
      if (!wrap || !sfToggle || !sfBackup) return;
      var sfOn = false, sfSdkLoaded = false;
      function loadSfSdk(done) {
        if (sfSdkLoaded || typeof window.Sketchfab === 'function') { sfSdkLoaded = true; done(); return; }
        var url = sfToggle.getAttribute('data-sf-js');
        if (!url) { done(); return; }
        var s = document.createElement('script');
        s.async = true;
        s.src = url;
        s.onload = function () { sfSdkLoaded = true; done(); };
        s.onerror = function () { done(); };
        document.head.appendChild(s);
      }
      // R-290：单按钮状态同步 —— 程序化开关的 aria-pressed 反映当前是否处于 iframe 视图，
      //   同时把入口 #model_viewer_hint 的无障碍文案切成「下一步会做什么」（图标无可见文字）。
      function markDock(active) {
        sfToggle.setAttribute('aria-pressed', active === 'sf' ? 'true' : 'false');
        if (!hint) return;
        var label;
        if (active === 'sf') {
          label = '切换回本地 3D 模型';
        } else if (wrap.classList.contains('mv-ready')) {
          label = '查看' + (sfToggle.getAttribute('data-sf-label') || '备用 3D 视图') + '（备用 3D 视图）';
        } else {
          label = '查看备用 3D 视图（iframe）';
        }
        hint.setAttribute('aria-label', label);
        hint.setAttribute('title', label);
      }
      // R-290：本地模型就绪时，由主脚本回调这里刷新入口按钮的动作文案。
      window.alMvSfHintReady = function () { markDock('glb'); };
      function enableSfBackup() {
        if (sfOn) return;
        sfOn = true;
        sfBackup.hidden = false;
        wrap.classList.add('mv-sf-on');
        markDock('sf');
        loadSfSdk(function () {
          if (typeof window.alEnableSketchfabBackup === 'function') { window.alEnableSketchfabBackup(); return; }
          // 兜底：carousel.js 尚未就绪时用最小接线（只启动 viewer，不做相机预设）
          var frame = document.getElementById('sketchfab-model');
          if (!frame || typeof window.Sketchfab !== 'function') return;
          frame.style.height = (window.innerHeight * 1.2) + 'px';
          var api = new window.Sketchfab(frame);
          api.init(sfToggle.getAttribute('data-sf-uid'), {
            success: function (viewer) { viewer.start(); },
            error: function () { /* 备用视图也失败：保留封面 */ }
          });
        });
      }
      function disableSfBackup() {
        if (!sfOn) return;
        sfOn = false;
        wrap.classList.remove('mv-sf-on');
        sfBackup.hidden = true;
        markDock('glb');
        // 回到 model-viewer：失败过（.mv-failed）继续给重试入口；已 ready 直接回到 3D；否则恢复封面。
        if (wrap.classList.contains('mv-failed')) {
          if (fb) fb.style.display = 'flex';
          if (cover) cover.style.display = 'none';
        } else if (wrap.classList.contains('mv-ready')) {
          if (fb) fb.style.display = 'none';
          if (cover) cover.style.display = 'none';
        } else if (cover) {
          cover.style.display = '';
        }
      }
      sfToggle.addEventListener('click', function () {
        if (sfOn) { disableSfBackup(); } else { enableSfBackup(); }
      });
      // 加载器的 fail() 通过该钩子触发自动回退（脚本顺序保证它在任何失败之前已定义）。
      window.alMvSfEnable = enableSfBackup;
      window.alMvSfDisable = disableSfBackup;
    })();
else
  //- 配置关闭（theme.model_viewer.enable=false）时回退原始 Sketchfab iframe
