//- 2026-10-21（用户指示）：首页 3D 已换成 bruno-simon/folio-2025（bg/folio iframe）。
//-   原首页 model-viewer + 本地 home.glb + Sketchfab 备用视图（含封面贴图）+ 底部 3D 控制坞
//-   全部移除，仅保留 #model_viewer_wrapper 作为首页 3D 的容器：
//-   scripts/home-town-bg.js 注入 source/bg/home-town.js，在容器内创建 .town-hero iframe。
//-   注意：model-viewer 仍被 /gallery/sketching/ 使用（source/js/models-gallery.js 按需注入），
//-   因此 vendor 脚本本身保留，只是首页不再引用。
.model-viewer-wrapper#model_viewer_wrapper
#carousel
  each content,page in theme.carousel_contents
    .carousel-box
      //- | !{content.bg_img}
      //- .site-hi Hi, I'm KP.
      .site-info 
        .site-subtitle
          | !{rp_html(content.subtitle)}
        h1.site-title
          | !{content.title}
          a(onclick="plusSlides()") Next
  //- a#carouselNextSlide(onclick="plusSlides()") Next

  #carousel-indictors
    span.carousel-dot(onclick="currentSlide(1)")
    span.carousel-dot(onclick="currentSlide(2)")
    span.carousel-dot(onclick="currentSlide(3)")
    span.carousel-dot(onclick="currentSlide(4)")
//- 已禁用（R-059）：原 GitHub CDN 镜像脚本 Uzizkp/jscdn（carousel.js）无国内副本，保持注释不加载；如启用需自托管
script(src=url_for(theme.pages.carousel))
#site-name.site-name
  a KUANGPU
  br
  a ZHANG
#show-index-info
  a 
    i(class="fa-solid fa-arrow-left")
#pined-pages.pined-pages
  p LATEST NEWS
  //- 滚动容器：标题固定在外部，仅气泡滚动
  .bubble-scroll
    - let postLimit = 10
    - let bubbleIndex = 0
    - stable_posts(site.posts, -1).slice(0, postLimit).forEach(function (article){
      - let link = article.link || article.path
      - let title = article.title || _p('no_title')
      - let post_cover = article.cover
      - let description = article.description || strip_html(article.content || '').replace(/\s+/g, ' ').substring(0, 40)
      .page(style=`--i: ${bubbleIndex}`)
        .description
          a(href=url_for(link) title=title)
            | !{title} : !{description}
        if post_cover
          img(src=url_for(post_cover) onerror=`this.onerror=null;this.src='${url_for(theme.error_img.post_page)}'` alt=title)
      - bubbleIndex++
    - })


!= page.content