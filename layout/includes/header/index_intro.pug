
//- R-060：首页 3D 改为自托管 model-viewer + 本地 GLB（不再引用 sketchfab.com）。
//- theme.model_viewer 缺失也能用：enable=true / src=/models/home.glb / viewer_js=/js/vendor/model-viewer/model-viewer.min.js。
- var mv = (theme.model_viewer || {})
- var mv_enable = (mv.enable === undefined) ? true : mv.enable
- var mv_src = mv.src || '/models/home.glb'
- var mv_js = mv.viewer_js || '/js/vendor/model-viewer/model-viewer.min.js'
- var mv_poster = mv.poster || ((theme.pages && theme.pages.sketchfab_cover_img) || '')

if mv_enable
  script(type="text/javascript" src=url_for(mv_js) defer)
  .model-viewer-wrapper
    model-viewer#home-model(
      src=url_for(mv_src)
      alt="首页 3D 模型"
      camera-controls
      auto-rotate
      loading="lazy"
      reveal="auto"
      shadow-intensity="1"
      environment-image="neutral"
      poster=(mv_poster ? url_for(mv_poster) : null)
    )
    #model_viewer_loading_cover
      if mv_poster
        img(src=url_for(mv_poster))
    .model-viewer-fallback#model_viewer_fallback
      if mv_poster
        img(src=url_for(mv_poster))
      else
        p 3D 模型暂不可用
  script.
    (function () {
      var el = document.getElementById('home-model');
      if (!el) return;
      var cover = document.getElementById('model_viewer_loading_cover');
      var fb = document.getElementById('model_viewer_fallback');
      el.addEventListener('load', function () { if (cover) cover.style.display = 'none'; });
      el.addEventListener('error', function () {
        if (cover) cover.style.display = 'none';
        if (fb) fb.style.display = 'flex';
        el.style.display = 'none';
      });
    })();
else
  //- 配置关闭（theme.model_viewer.enable=false）时回退原始 Sketchfab iframe
  script(type="text/javascript" src=url_for(theme.pages.sketchfab))
  .sketchfab-embed-wrapper(style="width: 100%;height: 100%;")
    iframe(runat='server' id="sketchfab-model" frameborder="0" sandbox="allow-scripts allow-same-origin" allow="autoplay; fullscreen; xr-spatial-tracking")
    #sketchfab_loading_cover
      img(src=url_for(theme.pages.sketchfab_cover_img))

#carousel
  each content,page in theme.carousel_contents
    .carousel-box
      //- | !{content.bg_img}
      //- .site-hi Hi, I'm KP.
      .site-info 
        .site-subtitle
          | !{content.subtitle}
        h1.site-title
          | !{content.title}
          a(onclick="plusSlides()") Next
  //- a#carouselNextSlide(onclick="plusSlides()") Next

  #carousel-indictors
    span.carousel-dot(onclick="currentSlide(1)")
    span.carousel-dot(onclick="currentSlide(2)")
    span.carousel-dot(onclick="currentSlide(3)")
    span.carousel-dot(onclick="currentSlide(4)")
//- script(src="https://cdn.jsdelivr.net/gh/Uzizkp/jscdn@main/blog/js/carousel.js")
script(src=url_for(theme.pages.carousel))
#site-name.site-name
  a KUANGPU
  br
  a ZHANG
#show-index-info
  a 
    i(class="fa-solid fa-arrow-left")
#pined-pages.pined-pages
  p LATEST NEWS
  //- 滚动容器：标题固定在外部，仅气泡滚动
  .bubble-scroll
    - let postLimit = 10
    - let bubbleIndex = 0
    - site.posts.sort('date', 'desc').limit(postLimit).each(function (article){
      - let link = article.link || article.path
      - let title = article.title || _p('no_title')
      - let post_cover = article.cover
      - let description = article.description || strip_html(article.content || '').replace(/\s+/g, ' ').substring(0, 40)
      .page(style=`--i: ${bubbleIndex}`)
        .description
          a(href=url_for(link) title=title)
            | !{title} : !{description}
        if post_cover
          img(src=url_for(post_cover) onerror=`this.onerror=null;this.src='${url_for(theme.error_img.post_page)}'` alt=title)
      - bubbleIndex++
    - })


!= page.content