//-   模型清单仍由 theme.model_viewer.models 驱动；R-290 起可见 UI 只留一个图标按钮，
//-   本地 GLB 取清单里的第一项（缺省 = home.glb），备用视图仍取 sketchfab 项。
- var mv_models = (mv.models && mv.models.length) ? mv.models : [{ label: '机器人', src: mv_src, animation: 'Idle' }]
- var mv_glb_models = mv_models.filter(function (m) { return !m.kind || m.kind === 'glb' })
- var mv_sf_models = mv_models.filter(function (m) { return m.kind === 'sketchfab' })
- var mv_sf_label = (mv_sf_models[0] && mv_sf_models[0].label) || '原创模型'
