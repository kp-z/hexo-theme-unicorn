- var error_top_img = theme.error_404.background || theme.default_top_img
- var error_bg = `background-image: url('${url_for(error_top_img)}')`

#body-wrap.error
  div(style='display: none')
    include ./header/index.pug

  #error-wrap
    .error-content
      .error-img(style=error_bg)
      .error-info
        h1.error_title= '404'
        .error_subtitle= theme.error_404.subtitle
        a.button--animated(href=config.root)
          i.fas.fa-rocket
          = _p('error404.back_button')